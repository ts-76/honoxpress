{
  "name": "your-documentation",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vp dev --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node build/build.mjs",
    "build:client": "vp build --mode client",
    "build:ssg": "vp build --mode ssg",
    "build:worker": "vp build --mode worker",
    "preview": "cf dev",
    "preview:dry-run": "cf build && cf deploy --dry-run --prebuilt",
    "check": "vp check",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "types:cf": "cf workers types",
    "build:cf": "cf build"
  },
  "dependencies": {
    "hono": "4.13.12",
    "honox": "0.1.61",
    "honoxpress": "__HONOXPRESS_VERSION__"
  },
  "devDependencies": {
    "@cloudflare/config": "0.20.0",
    "@hono/vite-build": "1.11.1",
    "@hono/vite-ssg": "0.3.3",
    "@mdx-js/rollup": "3.1.1",
    "@types/node": "22.20.4",
    "remark-frontmatter": "5.0.0",
    "remark-mdx-frontmatter": "6.0.0",
    "typescript": "5.9.3",
    "vite-plus": "1.0.0",
    "wrangler": "4.145.0"
  },
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
