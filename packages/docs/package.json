{
  "name": "@honox-docs-poc/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Local evaluation name for Hono JSX docs helpers; publication identity is undecided",
  "files": [
    "dist",
    "README.md",
    "templates"
  ],
  "type": "module",
  "sideEffects": [
    "./templates/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./templates/*": "./templates/*"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "hono": "^4.13.12",
    "vite-plus": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=26.0.0"
  }
}
