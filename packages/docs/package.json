{
  "name": "honoxpress",
  "version": "0.1.2",
  "private": false,
  "description": "Hono JSX documentation metadata and build helpers with consumer-owned UI templates",
  "homepage": "https://github.com/ts-76/honoxpress#readme",
  "bugs": {
    "url": "https://github.com/ts-76/honoxpress/issues"
  },
  "license": "MIT",
  "author": "ts-76",
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-76/honoxpress.git"
  },
  "files": [
    "dist",
    "README.md",
    "templates",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./templates/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./templates/*": "./templates/*"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "hono": "^4.13.12",
    "vite-plus": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=26.0.0"
  }
}
