{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "a3ddd9e070274d9fbc2e3ea5611799fdbc0ec646",
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/docs/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "release-policy.json",
          "jsonpath": "$.version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Maintenance",
          "hidden": true
        }
      ]
    }
  }
}
