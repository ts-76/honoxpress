{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "paths": { "@components/*": ["./.generated/adapted/*"] }
  },
  "include": ["pages", "components", "integration", "vite.config.ts", "void.config.ts"]
}
