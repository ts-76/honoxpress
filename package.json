{
  "name": "honoxpress-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:package": "pnpm --filter honoxpress build",
    "check": "vp check",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "typecheck": "pnpm build:package && tsc --noEmit && pnpm --filter honoxpress-example typecheck",
    "test:unit": "vp test run tests/core.test.ts tests/build-api.test.ts tests/ui.test.ts --reporter=default --reporter=json --outputFile=artifacts/package-tests.json",
    "test": "vp test run",
    "verify": "pnpm build:package && pnpm check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm --filter honoxpress-example verify && pnpm test:consumer && pnpm test:release && pnpm release:plan && pnpm release:dry-run",
    "dev": "pnpm --filter honoxpress-example dev",
    "build": "pnpm --filter honoxpress-example build",
    "build:client": "pnpm --filter honoxpress-example build:client",
    "build:ssg": "pnpm --filter honoxpress-example build:ssg",
    "build:worker": "pnpm --filter honoxpress-example build:worker",
    "preview": "pnpm --filter honoxpress-example preview",
    "preview:dry-run": "pnpm --filter honoxpress-example preview:dry-run",
    "build:cf": "pnpm --filter honoxpress-example build:cf",
    "types:cf": "pnpm --filter honoxpress-example types:cf",
    "test:build": "pnpm --filter honoxpress-example test:build",
    "test:browser": "pnpm --filter honoxpress-example test:browser",
    "evidence": "pnpm --filter honoxpress-example evidence",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "pack:docs": "pnpm build:package && pnpm --dir packages/docs pack --pack-destination ../../artifacts/package",
    "test:release": "node --test scripts/release/release.test.mjs scripts/release/dispatch-release.test.mjs",
    "release:plan": "node scripts/release/release-plan.mjs",
    "release:dry-run": "node scripts/release/release-dry-run.mjs"
  },
  "dependencies": {
    "honoxpress": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "hono": "4.13.12",
    "npm": "11.21.0",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
