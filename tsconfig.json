{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["app", "build", "tests", "vite.config.ts", "playwright.config.ts"]
}
