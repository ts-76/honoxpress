{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["vite-plus/client", "node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "app",
    "build",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "cloudflare.config.ts",
    "wrangler.config.ts",
    ".cloudflare/types"
  ]
}
