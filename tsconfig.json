{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["vite-plus/client", "node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["packages/docs/src", "tests", "vite.config.ts", "packages/docs/templates"]
}
